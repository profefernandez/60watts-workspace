# 60 Watts of Clarity — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.

# ── Directus Backend ──
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055

# ── AI Provider Toggle ──
# "launchlemonade" (default) for Profé chat + Context Engine
# "anthropic" as fallback for direct Claude access
AI_PROVIDER=launchlemonade

# ── LaunchLemonade (Primary — Profé Agent + Context Engine) ──
LAUNCHLEMONADE_API_KEY=
LAUNCHLEMONADE_PROFE_ID=
# LAUNCHLEMONADE_CONTEXT_ID=

# ── Anthropic Claude API (Software-Specific: Research, YouTube) ──
# Used by /api/research and /api/youtube for web_search tool
# NOT used for Profé chat when AI_PROVIDER=launchlemonade
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── External Connectors (Phase 2+) ──
# PERPLEXITY_API_KEY=
# GOOGLE_SCHOLAR_API_KEY=
# YOUTUBE_API_KEY=
# PUBMED_API_KEY=

# ── Database (Phase 2+) ──
# DATABASE_URL=

# ── S3-Compatible Storage (Phase 2+) ──
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
