# 60 Watts of Clarity — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.

# ── LaunchLemonade API (active provider) ──
LAUNCHLEMONADE_API_URL=https://api.launchlemonade.com/v1/messages
LAUNCHLEMONADE_MODEL=launchlemonade-default
LAUNCHLEMONADE_API_KEY=
LAUNCHLEMONADE_PROFE_API_KEY=
LAUNCHLEMONADE_SEARCH_API_KEY=
LAUNCHLEMONADE_CONTEXTUAL_SEARCH_API_KEY=
LAUNCHLEMONADE_KB_SCAN_API_KEY=

