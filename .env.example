# 60 Watts of Clarity — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.

# ── Directus Backend ──
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055

# ── LaunchLemonade (Profé Agent + Context Engine) ──
# Powers all AI features on the platform
LAUNCHLEMONADE_API_KEY=
LAUNCHLEMONADE_PROFE_ID=
# LAUNCHLEMONADE_CONTEXT_ID=

# ── User-Provided API Keys ──
# Research and YouTube use the user's own API keys (stored in Directus
# user_api_keys collection, passed per-request). No server-side keys needed.
# Supported providers: Anthropic (Claude + web_search), more planned.

# ── External Connectors (Future) ──
# PERPLEXITY_API_KEY=
# GOOGLE_SCHOLAR_API_KEY=
# YOUTUBE_API_KEY=
# PUBMED_API_KEY=

# ── S3-Compatible Storage (Future) ──
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
